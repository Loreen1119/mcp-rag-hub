# ============================================================
# 构建上下文排除项 —— 让镜像只包含"运行需要的东西"
#
# 权衡说明：这里是**黑名单**（排除），不是白名单。原因是语料会变、还有新脚本加进来，
# 白名单容易漏。排除项的判据只有两条：
#   ① 体积大且运行不需要（虚拟环境、缓存、索引、截图）
#   ② 含本机私密/环境相关，不该进镜像（会话存档、IDE 配置、日志）
# ============================================================

# --- ① 体积大，或由卷挂载提供 ---
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
chroma_db/              # 向量索引：由 docker-compose 挂载宿主目录，保证重建后还在
chroma_db.old/
experiments/            # 评测产物：挂载宿主目录，方便跑完直接在本机看
screenshots/            # 6 张 PNG，README 用，运行不需要

# --- ② 本机环境相关，不该进镜像 ---
.git/
.gitignore
.workbuddy/             # Agent 会话记忆
.claude/
.codex/
.vscode/
.idea/
*.log
.env
scripts/capture_ui.py    # 依赖本机跑起来的界面来截图，容器内用不上

# --- 文档（运行不需要；但 corpora/ 必须留，它是知识库本体）---
docs/
docs_knowledge/
journal/
