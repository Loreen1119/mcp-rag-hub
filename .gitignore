# Python
__pycache__/
*.pyc
*.pyo

# ChromaDB 向量数据（几百MB，不提交）
chroma_db/
chroma_db.old/

# 实验产物：全部纳管（总体积约 170KB）
# 2026-09-14 修正：此前这里是 `experiments/*` 全忽略 + 两条 `!` 例外，结果
# `llm_evaluation_results.json` 这类**关键证据**不在版本控制里 —— 一旦被
# `llm_eval.py --sample/--quick` 覆盖就无任何恢复通道（该文件确实差点丢过）。
# 评测数字就是证据链，没有理由忽略；如需排除临时大文件，单独加 ignore 规则。

# 备份文件
*.bak

# 误将 pip 输出重定向成的垃圾文件（如 `pip install x>=3.0` 未加引号）
=*

# 自动生成的知识图谱三元组缓存（可通过 kg_builder.py 重新生成）
data/knowledge_triples.jsonl
# 缓存伴随的 sidecar 校验文件（运行时派生，缺失/损坏时 kg_builder 自动全量重建）
data/knowledge_triples.jsonl.meta

# Claude 配置
.claude/

# 工具产物（codex 会话/记忆）
.codex/

# Agent 工作目录（会话记忆/日志，非交付物）
.workbuddy/

# 运行日志
*.log

# 环境
.env
.venv/
venv/

# IDE
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db
